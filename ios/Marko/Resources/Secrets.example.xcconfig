// Copy this file to Secrets.xcconfig and fill in your real values.
// Secrets.xcconfig is gitignored; never commit your live keys.
//
// xcconfig quirk: '//' starts a comment, even inside a value. To put
// a URL in a value, break the double-slash with $()/ as shown below;
// the build system substitutes it back to //.

MARKO_GOOGLE_MAPS_API_KEY = YOUR_GOOGLE_MAPS_API_KEY
MARKO_CANOPY_BACKEND_URL = https:/$()/YOUR-CANOPY-SERVICE.run.app
