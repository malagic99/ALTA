// Copy this file to Secrets.xcconfig and fill in your real value.
// Secrets.xcconfig is gitignored; never commit your live URLs.
//
// xcconfig quirk: '//' starts a comment, even inside a value. To put
// a URL in a value, break the double-slash with $()/ as shown below;
// the build system substitutes it back to //.

MARKO_CANOPY_BACKEND_URL = https:/$()/YOUR-MARKO-BACKEND.run.app
